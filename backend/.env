# ==============================================================
# FIXIT Backend - Environment Variables
# ==============================================================
# 
# Copy this file to .env and fill in actual values
# .env should NEVER be committed to git
#
# ==============================================================

# ============= APPLICATION SETTINGS =============

# Application port (default: 8080)
PORT=8080

# Spring profile (dev, staging, prod)
SPRING_PROFILE=dev

# ============= SUPABASE CONFIGURATION =============
# Get these from Supabase Dashboard > Settings > API

# Supabase Project URL
# Example: https://your-project-id.supabase.co
SUPABASE_URL=https://xqqeprnbntotuspddboh.supabase.co

# Supabase Anon/Public Key (safe for frontend)
# Found in: Supabase Dashboard > Settings > API > anon (public)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhxcWVwcm5ibnRvdHVzcGRkYm9oIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgyNzYzMTMsImV4cCI6MjEwMzg1MjMxM30.uwx7vtIuwL8ywUkEvn8INHTupBIzrqu_L2YkTuS94jw

# Supabase Service Role Key (BACKEND ONLY - NEVER expose publicly)
# Found in: Supabase Dashboard > Settings > API > service_role (SECRET)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhxcWVwcm5ibnRvdHVzcGRkYm9oIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODI3NjMxMywiZXhwIjoyMTAzODUyMzEzfQ.FqV2N09qO_9VlGxgtaFwXYSKCTr7Fe-6AvNBK-CPbOQ
# ============= DATABASE CONFIGURATION =============
# These are Supabase PostgreSQL connection details

# Database connection URL
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/fixit_db

# Database username (usually 'postgres' for Supabase)
DATABASE_USER=postgres

# Database password (from Supabase project creation)
DATABASE_PASSWORD=needraf786#&

# ============= SECURITY =============

# JWT Secret (generate a secure random string)
# Linux/Mac: openssl rand -hex 32
# Windows: Use an online generator or PowerShell
JWT_SECRET=e97d68fc5ec18ea54fc631cfca3c02a6a53782065ec496ba1cd82dfcbd1931b3

# JWT Expiration in milliseconds (24 hours = 86400000)
JWT_EXPIRATION=86400000

# ============= ADMIN CONFIGURATION =============

# Admin email for system notifications
ADMIN_EMAIL=fixitmobileservicess@gmail.com

# WhatsApp business number (for enquiry messages)
# Format: +91XXXXXXXXXX (country code + number)
WHATSAPP_NUMBER=+918870783647

# ============= CORS CONFIGURATION =============

# Allowed origins (comma-separated)
# Frontend URLs that can make requests to this backend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourfrontend.com

# ============= EMAIL CONFIGURATION =============
# Only needed if not using Supabase Auth for emails

# SMTP Host (e.g., smtp.gmail.com)
MAIL_HOST=smtp.gmail.com

# SMTP Port (usually 587 for TLS)
MAIL_PORT=587

# SMTP username (your email)
MAIL_USERNAME=your-email@gmail.com

# SMTP password or app-specific password
MAIL_PASSWORD=your-app-specific-password

# ============= IMAGE UPLOAD =============

# Maximum file size for image uploads (bytes)
# 5MB = 5242880 bytes
IMAGE_MAX_SIZE=5242880

# ============= RATE LIMITING =============

# Enable rate limiting (true/false)
RATE_LIMIT_ENABLED=true

# ============= FEATURE FLAGS =============

# Enable/disable specific features
FEATURE_WHATSAPP_INTEGRATION=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_IMAGE_COMPRESSION=true

# ==============================================================
# RENDER DEPLOYMENT VARIABLES
# ==============================================================
# 
# When deploying to Render.com, add these environment variables
# in the Render dashboard (Environment > Environment Variables)
#
# Copy the same values you used locally, but make sure to use
# PRODUCTION values (not localhost URLs)
#
# ==============================================================

# For production deployment, use:
# SUPABASE_URL=https://your-production-project.supabase.co
# SUPABASE_ANON_KEY=your-production-anon-key
# SUPABASE_SERVICE_KEY=your-production-service-key
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# SPRING_PROFILE=prod

# ==============================================================
# SECURITY NOTES
# ==============================================================
#
# ⚠️  NEVER commit .env file to git
# ⚠️  NEVER share SUPABASE_SERVICE_KEY publicly
# ⚠️  NEVER hardcode secrets in code
# ⚠️  Use strong, random values for JWT_SECRET
# ⚠️  Use app-specific passwords for MAIL_PASSWORD (not account password)
# ⚠️  Rotate JWT_SECRET regularly
#
# ==============================================================
